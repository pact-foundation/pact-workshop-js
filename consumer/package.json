{
  "name": "consumer",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "axios": "^1.13.6",
    "prop-types": "15.8.1",
    "react": "^19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "spectre.css": "^0.5.9",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@pact-foundation/pact": "^16.3.0",
    "@pact-foundation/pact-cli": "^18.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "nock": "15.0.0",
    "rimraf": "6.1.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "jest",
    "preview": "vite preview",
    "eject": "react-scripts eject",
    "pretest:pact": "rimraf pacts/*.json",
    "test:pact": "cross-env CI=true jest --testTimeout=30000 pact.spec.js",
    "test:unit": "cross-env CI=true jest api.spec.js",
    "pact:publish": "pact-broker publish ./pacts --consumer-app-version=\"1.0.0\" --auto-detect-version-properties --broker-base-url=http://127.0.0.1:8000 --broker-username pact_workshop --broker-password pact_workshop"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ]
  }
}
